# Server
PORT=3001
HOST=127.0.0.1

# Database: sqlite (default) atau mysql / mariadb
DB_CLIENT=sqlite
DB_URL=./data/portfolio.sqlite

# Untuk MySQL/MariaDB (kompatibel dengan kode yang sama):
# DB_CLIENT=mysql
# DB_URL=mysql://user:password@127.0.0.1:3306/portfolio

# Akun admin awal. Dipakai hanya saat tabel admin masih kosong.
# WAJIB diganti sebelum produksi.
ADMIN_NAME=Admin Museum
ADMIN_EMAIL=admin@nekoneko.local
ADMIN_PASSWORD=admin12345

# Set 1 bila situs produksi sudah memakai HTTPS di balik reverse proxy.
# COOKIE_SECURE=1
